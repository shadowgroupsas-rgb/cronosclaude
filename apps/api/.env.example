# Server
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cronos_user
DB_PASSWORD=cronos_password
DB_DATABASE=cronos

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars-here-change-me
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-server-key

# Firebase Admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=cronos-uploads
AWS_S3_REGION=us-east-1

# Cataleya External API
CATALEYA_API_KEY=auto-generated-on-setup

# App
APP_NAME=Cronos
COMPANY_NAME=Copower Energy Solutions
FRONTEND_URL=http://localhost:3000
